@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:io.catenax.battery_pass_supplier:1.0.0#> .
@prefix pcf: <urn:samm:io.admin-shell.idta.carbon_footprint:1.0.0#> .
@prefix batteryPassCarbonFootprint: <urn:samm:io.admin-shell.idta.batterypass.carbon_footprint:1.0.0#> .

:ProductCarbonFootprintSupplier a samm:Aspect ;
   samm:preferredName "Carbon Footprint for Battery Passport"@en ;
   samm:preferredName "C02 Footprint für den Batteriepass"@de ;
   samm:description "Provides the means to access the Carbon Footprint of the asset in the context of a Battery Passport."@en ;
   samm:see <https://admin-shell.io/idta/SubmodelTemplate/CarbonFootprint/1/0> ;
   samm:see <https://admin-shell.io/IDTA-02035-3/1/0> ;
   samm:see <https://admin-shell.io/IDTA-02023/1/0> ;
   samm:properties ( 
   [ samm:property :productCarbonFootprints; samm:payloadName "ProductCarbonFootprints" ] 
   ) ;
   samm:operations ( ) ;
   samm:events ( ) .


:productCarbonFootprints a samm:Property ;
   samm:preferredName "product carbon footprints"@en ;
   samm:preferredName "Produkt CO2-Fußabdrücke"@de ;
   samm:description "(Set) Balance of greenhouse gas emissions along the entire life cycle of a product in a defined application and in relation to a defined unit of use."@en ;
   samm:see <https://admin-shell.io/idta/CarbonFootprint/CarbonFootprints/1/0> ;
   samm:characteristic :ProductCarbonFootprintSet .

:ProductCarbonFootprintSet a samm-c:Set ;
   samm:dataType :ProductCarbonFootprint .  


:ProductCarbonFootprint a samm:Entity ;
   samm:preferredName "carbon footprint of a product"@en ;
   samm:description "Balance of greenhouse gas emissions along the entire life cycle of a product in a defined application and in relation to a defined unit of use."@en ;
   samm:see <https://admin-shell.io/idta/CarbonFootprint/ProductCarbonFootprint/1/0> ;
   samm:properties ( 
   [ samm:property pcf:pcfCalculationMethods; samm:payloadName "PcfCalculationMethods" ] 
   [ samm:property batteryPassCarbonFootprint:pcfCo2eq; samm:payloadName "PcfCo2eq" ] 
   [ samm:property batteryPassCarbonFootprint:referenceImpactUnitForCalculation; samm:payloadName "ReferenceImpactUnitForCalculation" ] 
   [ samm:property batteryPassCarbonFootprint:quantityOfMeasureForCalculation; samm:payloadName "QuantityOfMeasureForCalculation" ]
   [ samm:property batteryPassCarbonFootprint:lifeCyclePhases; samm:payloadName "LifeCyclePhases" ] 
   [ samm:property batteryPassCarbonFootprint:performanceClass; samm:optional true; samm:payloadName "PerformanceClass" ] 
   [ samm:property batteryPassCarbonFootprint:webLinkToPublicCarbonFootprintStudy; samm:optional true; samm:payloadName "WebLinkToPublicCarbonFootprintStudy" ]
   ) .
 
