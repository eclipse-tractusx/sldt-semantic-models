@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bp: <urn:samm:io.admin-shell.idta.batterypass.circularity:1.0.0#> .
@prefix docu: <urn:samm:io.admin-shell.idta.handover_documentation:2.0.1#> .
@prefix shared: <urn:samm:io.admin-shell.idta.shared:3.1.0#> .
@prefix : <urn:samm:io.catenax.batterypass.component_supplier.circularity:1.0.0#> .
@prefix batterypassCircularity: <urn:samm:io.admin-shell.idta.batterypass.circularity:1.0.1#> .

:Circularity a samm:Aspect ;
   samm:description """Dismantling information (including at least: exploded diagrams of the battery system/pack showing the location of battery cells; disassembly sequences; type and number of fastening techniques to be unlocked; tools required for disassembly; warnings if risk of damaging parts exists; amount of cells used and layout); part numbers for components and contact details of sources for replacement spares; safety measures 
   
   (Annex XIII (2b-d)); usable extinguishing agent (Annex VI, Part A(9))."""@en ;
   samm:properties ( 
   	[ samm:property batterypassCircularity:dismantlingAndRemovalInformation; samm:optional true; samm:payloadName "DismantlingAndRemovalInformation" ] 
   	[ samm:property batterypassCircularity:sparePartSources; samm:optional true; samm:payloadName "SparePartSources" ] 	 
	[ samm:property batterypassCircularity:recycledContent; samm:payloadName "RecycledContentInformation" ]  
	[ samm:property batterypassCircularity:safetyMeasures; samm:optional true; samm:payloadName "SafetyMeasures" ] 
	[ samm:property batterypassCircularity:endOfLifeInformation; samm:optional true; samm:payloadName "EndOfLifeInformation" ]  
	[ samm:property batterypassCircularity:renewableContent; samm:payloadName "RenewableContent" ]  	 
	) ;
   samm:operations ( ) ;
   samm:events ( ) .


   
