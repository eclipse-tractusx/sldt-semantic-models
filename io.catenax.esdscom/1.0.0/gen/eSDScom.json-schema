{
  "$schema" : "http://json-schema.org/draft-04/schema",
  "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#eSDScom",
  "description" : "The SDScom root element",
  "type" : "object",
  "components" : {
    "schemas" : {
      "SdscomVersionEnumCharacteristic" : {
        "type" : "string",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#SdscomVersionEnumCharacteristic",
        "description" : "Allowed values for Sdscom Version Enum.",
        "enum" : [ "5.6" ]
      },
      "SdscomSubsetEnumCharacteristic" : {
        "type" : "string",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#SdscomSubsetEnumCharacteristic",
        "description" : "Allowed values for Sdscom Subset Enum.",
        "enum" : [ "SdsComXml Light", "SDScomBau", "SDScomChem", "full", "other" ]
      },
      "Text" : {
        "type" : "string",
        "x-samm-aspect-model-urn" : "urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#Text",
        "description" : "Describes a Property which contains plain text. This is intended exclusively for human readable strings, not for identifiers, measurement values, etc."
      },
      "DateCharacteristic" : {
        "type" : "string",
        "format" : "date",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#DateCharacteristic",
        "description" : "Value of XSD type xsd:date."
      },
      "EsdscomPhraseCatalogueIdCharacteristic" : {
        "type" : "number",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#EsdscomPhraseCatalogueIdCharacteristic",
        "description" : "Value of XSD type xsd:integer."
      },
      "PhraseCatalogue" : {
        "description" : "Catalogue of standard phrases used in the datasheet. Used in chapter 0 and referred in for example exposure scenarios. PhraseCatalogues and PhraseIds simplifies translation to other languages. Example: EUPhraC catalogue.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#PhraseCatalogue",
        "type" : "object",
        "properties" : {
          "phraseCatalogueName" : {
            "description" : "Phrase catalogue Name, eg. EuPhraC",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCatalogueName",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "phraseCatalogueIssuer" : {
            "description" : "Phrase catalogue issuer: Identification of the suppler of the phrase catalogue to the exporting system, eg. EuPhraC-Workinggroup.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCatalogueIssuer",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "phraseCatalogueVersion" : {
            "description" : "Catalogue version: The version no of the phrase catalog the information is based on to identify the actual version of the phrase catalogue applied. Phrase catalogues are updated more or less regularly, and different versions may show some differences.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCatalogueVersion",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "phraseCatalogueDate" : {
            "description" : "Date of release of the catalogue version: The version timestamp of the phrase catalogue the information is based on",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCatalogueDate",
            "allOf" : [ {
              "$ref" : "#/components/schemas/DateCharacteristic"
            } ]
          },
          "phraseCatalogueId" : {
            "description" : "Identifier of the phrase catalogue used.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCatalogueId",
            "allOf" : [ {
              "$ref" : "#/components/schemas/EsdscomPhraseCatalogueIdCharacteristic"
            } ]
          }
        },
        "required" : [ "phraseCatalogueDate" ]
      },
      "PhraseCatalogueList" : {
        "description" : "List of Phrase Catalogue values.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#PhraseCatalogueList",
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/PhraseCatalogue"
        }
      },
      "LanguageCodeEnumCharacteristic" : {
        "type" : "string",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#LanguageCodeEnumCharacteristic",
        "description" : "Allowed values for Language Code Enum.",
        "enum" : [ "aa", "ab", "ae", "af", "ak", "am", "an", "ar", "as", "av", "ay", "az", "ba", "be", "bg", "bh", "bi", "bm", "bn", "bo", "br", "bs", "ca", "ce", "ch", "co", "cr", "cs", "cu", "cv", "cy", "da", "de", "dv", "dz", "ee", "el", "en", "eo", "es", "et", "eu", "fa", "ff", "fi", "fj", "fo", "fr", "fy", "ga", "gd", "gl", "gn", "gu", "gv", "ha", "he", "hi", "ho", "hr", "ht", "hu", "hy", "hz", "ia", "id", "ie", "ig", "ii", "ik", "io", "is", "it", "iu", "ja", "jv", "ka", "kg", "ki", "kj", "kk", "kl", "km", "kn", "ko", "kr", "ks", "ku", "kv", "kw", "ky", "la", "lb", "lg", "li", "ln", "lo", "lt", "lu", "lv", "mg", "mh", "mi", "mk", "ml", "mn", "mr", "ms", "mt", "my", "na", "nb", "nd", "ne", "ng", "nl", "nn", "no", "nr", "nv", "ny", "oc", "oj", "om", "or", "os", "pa", "pi", "pl", "ps", "pt", "qu", "rm", "rn", "ro", "ru", "rw", "sa", "sc", "sd", "se", "sg", "si", "sk", "sl", "sm", "sn", "so", "sq", "sr", "ss", "st", "su", "sv", "sw", "ta", "te", "tg", "th", "ti", "tk", "tl", "tn", "to", "tr", "ts", "tt", "tw", "ty", "ug", "uk", "ur", "uz", "ve", "vi", "vo", "wa", "wo", "xh", "yi", "yo", "za", "zh", "zu" ]
      },
      "CountryCodeEnumCharacteristic" : {
        "type" : "string",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#CountryCodeEnumCharacteristic",
        "description" : "Allowed values for Country Code Enum.",
        "enum" : [ "AD", "AE", "AF", "AG", "AI", "AL", "AM", "AO", "AQ", "AR", "AS", "AT", "AU", "AW", "AX", "AZ", "BA", "BB", "BD", "BE", "BF", "BG", "BH", "BI", "BJ", "BL", "BM", "BN", "BO", "BQ", "BR", "BS", "BT", "BV", "BW", "BY", "BZ", "CA", "CC", "CD", "CF", "CG", "CH", "CI", "CK", "CL", "CM", "CN", "CO", "CR", "CU", "CV", "CW", "CX", "CY", "CZ", "DE", "DJ", "DK", "DM", "DO", "DZ", "EC", "EE", "EG", "EH", "ER", "ES", "ET", "FI", "FJ", "FK", "FM", "FO", "FR", "GA", "GB", "GD", "GE", "GF", "GG", "GH", "GI", "GL", "GM", "GN", "GP", "GQ", "GR", "GS", "GT", "GU", "GW", "GY", "HK", "HM", "HN", "HR", "HT", "HU", "ID", "IE", "IL", "IM", "IN", "IO", "IQ", "IR", "IS", "IT", "JE", "JM", "JO", "JP", "KE", "KG", "KH", "KI", "KM", "KN", "KP", "KR", "KW", "KY", "KZ", "LA", "LB", "LC", "LI", "LK", "LR", "LS", "LT", "LU", "LV", "LY", "MA", "MC", "MD", "ME", "MF", "MG", "MH", "MK", "ML", "MM", "MN", "MO", "MP", "MQ", "MR", "MS", "MT", "MU", "MV", "MW", "MX", "MY", "MZ", "NA", "NC", "NE", "NF", "NG", "NI", "NL", "NO", "NP", "NR", "NU", "NZ", "OM", "PA", "PE", "PF", "PG", "PH", "PK", "PL", "PM", "PN", "PR", "PS", "PT", "PW", "PY", "QA", "RE", "RO", "RS", "RU", "RW", "SA", "SB", "SC", "SD", "SE", "SG", "SH", "SI", "SJ", "SK", "SL", "SM", "SN", "SO", "SR", "SS", "ST", "SV", "SX", "SY", "SZ", "TC", "TD", "TF", "TG", "TH", "TJ", "TK", "TL", "TM", "TN", "TO", "TR", "TT", "TV", "TW", "TZ", "UA", "UG", "UM", "US", "UY", "UZ", "VA", "VC", "VE", "VG", "VI", "VN", "VU", "WF", "WS", "YE", "YT", "ZA", "ZM", "ZW" ]
      },
      "EsdscomPhraseIdCharacteristic" : {
        "type" : "number",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#EsdscomPhraseIdCharacteristic",
        "description" : "Value of XSD type xsd:integer."
      },
      "FullText" : {
        "description" : "Full Text structure from the eSDScom XML schema.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#FullText",
        "type" : "object",
        "properties" : {
          "languange" : {
            "description" : "Language identifier of the phrase; code or name.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#languange",
            "allOf" : [ {
              "$ref" : "#/components/schemas/LanguageCodeEnumCharacteristic"
            } ]
          },
          "country" : {
            "description" : "Country code or country of the language/text context; code or name.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#country",
            "allOf" : [ {
              "$ref" : "#/components/schemas/CountryCodeEnumCharacteristic"
            } ]
          }
        }
      },
      "FullTextList" : {
        "description" : "List of Full Text values.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#FullTextList",
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/FullText"
        }
      },
      "IntegerCharacteristic" : {
        "type" : "number",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#IntegerCharacteristic",
        "description" : "Value of XSD type xsd:integer."
      },
      "MergePhrase" : {
        "description" : "Phrase, using references to a coordination body assigning ids to all phrases. Ids have precedence over textual phrase values if both are present. Note the use of MergePhrase restricts the nesting depth to one level.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#MergePhrase",
        "type" : "object",
        "properties" : {
          "mergeText" : {
            "description" : "Merged text from phrase components.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#mergeText",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "delimiter" : {
            "description" : "Delimiter for composite phrases.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#delimiter",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "phraseId" : {
            "description" : "eSDScom (= EuPhraC, ESCom) phrase ID. Optional because user phrases and other phrase catalogues are allowed.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseId",
            "allOf" : [ {
              "$ref" : "#/components/schemas/EsdscomPhraseIdCharacteristic"
            } ]
          },
          "phraseCatalogueId" : {
            "description" : "Identifier of the phrase catalogue used.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCatalogueId",
            "allOf" : [ {
              "$ref" : "#/components/schemas/EsdscomPhraseCatalogueIdCharacteristic"
            } ]
          },
          "mergePhraseNo" : {
            "description" : "Number of the composite phrase in the phrase catalogue; technical identifier.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#mergePhraseNo",
            "allOf" : [ {
              "$ref" : "#/components/schemas/IntegerCharacteristic"
            } ]
          },
          "listItemNo" : {
            "description" : "list item number in the phrase catalogue; technical identifier.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#listItemNo",
            "allOf" : [ {
              "$ref" : "#/components/schemas/IntegerCharacteristic"
            } ]
          }
        }
      },
      "MergePhraseList" : {
        "description" : "List of Merge Phrase values.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#MergePhraseList",
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/MergePhrase"
        }
      },
      "Phrase" : {
        "description" : "Phrase, using optional references to a coordination body assigning ids to all phrases. PhraseId is a unique identifier (primary key) that must exist in each phrase catalogue. PhraseId has precedence over textual phrase values if both are present. PhraseCode is any official or system-internal phrase identifier which may be unique or not (and is often empty). Example: In EuPhraC, PhraseIds 9278174452 to 9278174455 all refer to PhraseCode = H341, however EuPhraC decided to name the other codes as H341.1, H341.2 and H341.3. Note the use of MergePhrase restricts the nesting depth to one level.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#Phrase",
        "type" : "object",
        "properties" : {
          "phraseId" : {
            "description" : "eSDScom (= EuPhraC, ESCom) phrase ID. Optional because user phrases and other phrase catalogues are allowed.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseId",
            "allOf" : [ {
              "$ref" : "#/components/schemas/EsdscomPhraseIdCharacteristic"
            } ]
          },
          "phraseCodeString64" : {
            "description" : "Phrase code with a maximum of 64 characters; technical identifier.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCodeString64",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "fullText" : {
            "description" : "If the Language and Country attributes are missing, Language and Country default to the FreetextLanguage and FreetextLanguageCountry named at the top of the XML file. \nIf there is only one instance of FullText, the Language and Country attributes should be omitted. If there is more than one instance, all but one should have those attributes.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#fullText",
            "allOf" : [ {
              "$ref" : "#/components/schemas/FullTextList"
            } ]
          },
          "mergePhrase" : {
            "description" : "Composite text phrase from the phrase catalogue.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#mergePhrase",
            "allOf" : [ {
              "$ref" : "#/components/schemas/MergePhraseList"
            } ]
          },
          "newLine" : {
            "description" : "specify this empty tag to indicate a line break",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#newLine",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "phraseCatalogueId" : {
            "description" : "Identifier of the phrase catalogue used.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCatalogueId",
            "allOf" : [ {
              "$ref" : "#/components/schemas/EsdscomPhraseCatalogueIdCharacteristic"
            } ]
          }
        }
      },
      "PhraseCharacteristic" : {
        "description" : "Single Phrase value.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#PhraseCharacteristic",
        "type" : "object",
        "allOf" : [ {
          "$ref" : "#/components/schemas/Phrase"
        } ]
      },
      "Language" : {
        "description" : "Language structure from the eSDScom XML schema.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#Language",
        "type" : "object",
        "properties" : {
          "freetextLanguageCode" : {
            "description" : "Enumeration with defined code set. Language independent. ISO 639-1 (2 letters)",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#freetextLanguageCode",
            "allOf" : [ {
              "$ref" : "#/components/schemas/LanguageCodeEnumCharacteristic"
            } ]
          },
          "freetextLanguageCountryCode" : {
            "description" : "If languages are used in more than one country, there might be national flavours that are significantly different (like pt-BR, en-US). In this case, indicate the country here. If empty, this field defaults to the originating country (pt-PT, en-GB).",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#freetextLanguageCountryCode",
            "allOf" : [ {
              "$ref" : "#/components/schemas/CountryCodeEnumCharacteristic"
            } ]
          },
          "freetextLanguageName" : {
            "description" : "String with actual language name. Possible to print. Automatic translation possible if a PhraseId is also given.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#freetextLanguageName",
            "allOf" : [ {
              "$ref" : "#/components/schemas/PhraseCharacteristic"
            } ]
          }
        },
        "required" : [ "freetextLanguageCode" ]
      },
      "LanguageCharacteristic" : {
        "description" : "Single Language value.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#LanguageCharacteristic",
        "type" : "object",
        "allOf" : [ {
          "$ref" : "#/components/schemas/Language"
        } ]
      },
      "LegalDocument" : {
        "description" : "Legal Document structure from the eSDScom XML schema.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#LegalDocument",
        "type" : "object",
        "properties" : {
          "legalDocumentFileName" : {
            "description" : "File name: For example, a locked PDF document. A fixed URL is possible.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#legalDocumentFileName",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "legalDocumentPrintDate" : {
            "description" : "Print date",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#legalDocumentPrintDate",
            "allOf" : [ {
              "$ref" : "#/components/schemas/DateCharacteristic"
            } ]
          },
          "legalDocumentSignature" : {
            "description" : "Digital signature: Digital signature to verify the document.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#legalDocumentSignature",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "internalSdsId" : {
            "description" : "Internal SDS identitifier: The identity of the SDS in the system that generates the XML file. This field will usually not be shown in the SDS, but will be useful in future updates with new versions of previously received data sheets. This field is sufficiently large to accept GUID (Global Unique ID) on each SDS. System generated identity – not to be displayed. Use the same id independetly of the version of the SDS.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#internalSdsId",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          }
        },
        "required" : [ "legalDocumentFileName" ]
      },
      "LegalDocumentCharacteristic" : {
        "description" : "Single Legal Document value.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#LegalDocumentCharacteristic",
        "type" : "object",
        "allOf" : [ {
          "$ref" : "#/components/schemas/LegalDocument"
        } ]
      },
      "RelatedDocuments" : {
        "description" : "Related Documents structure from the eSDScom XML schema.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#RelatedDocuments",
        "type" : "object",
        "properties" : {
          "fileName" : {
            "description" : "File name: For example, a locked PDF document. A fixed URL is possible.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#fileName",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "description" : {
            "description" : "Description of the file type etc.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#description",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          }
        },
        "required" : [ "fileName" ]
      },
      "RelatedDocumentsList" : {
        "description" : "List of Related Documents values.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#RelatedDocumentsList",
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/RelatedDocuments"
        }
      },
      "RegulationsRelatedToCountryOrRegion" : {
        "description" : "Regulations Related To Country Or Region structure from the eSDScom XML schema.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#RegulationsRelatedToCountryOrRegion",
        "type" : "object",
        "properties" : {
          "regulationsRelatedToCountryOrRegionCode" : {
            "description" : "Enumeration with defined code set.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#regulationsRelatedToCountryOrRegionCode",
            "allOf" : [ {
              "$ref" : "#/components/schemas/CountryCodeEnumCharacteristic"
            } ]
          },
          "regulationsRelatedToCountryOrRegionName" : {
            "description" : "String with actual country name. Possible to print. Automatic translation possible if a PhraseId is also given.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#regulationsRelatedToCountryOrRegionName",
            "allOf" : [ {
              "$ref" : "#/components/schemas/PhraseCharacteristic"
            } ]
          },
          "legalDocument" : {
            "description" : "Legal documents:",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#legalDocument",
            "allOf" : [ {
              "$ref" : "#/components/schemas/LegalDocumentCharacteristic"
            } ]
          },
          "relatedDocuments" : {
            "description" : "Reference to further documents related to the SDS e.g. technical bulletin or manual.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#relatedDocuments",
            "allOf" : [ {
              "$ref" : "#/components/schemas/RelatedDocumentsList"
            } ]
          }
        },
        "required" : [ "regulationsRelatedToCountryOrRegionCode" ]
      },
      "RegulationsRelatedToCountryOrRegionList" : {
        "description" : "List of Regulations Related To Country Or Region values.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#RegulationsRelatedToCountryOrRegionList",
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/RegulationsRelatedToCountryOrRegion"
        }
      },
      "InformationFromExportingSystem" : {
        "description" : "Information From Exporting System structure from the eSDScom XML schema.",
        "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#InformationFromExportingSystem",
        "type" : "object",
        "properties" : {
          "sdscomVersionNo" : {
            "description" : "The version of the eSDScom standard which is applied in the transmission of information. This version number also denotes the minimum version number for eSDScom phrase IDs referenced in the XML file. For backward compatibility, the tag name is still SDScom, although the standard now includes ESCom exposure scenarios and is thus named eSDScom.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#sdscomVersionNo",
            "allOf" : [ {
              "$ref" : "#/components/schemas/SdscomVersionEnumCharacteristic"
            } ]
          },
          "sdscomSubset" : {
            "description" : "Reference to the SDScomXML subsets SDScomBau and SDScomChem containing SDSComXML fields. More informaion to SDScomBau and SDScomChem are available at www.sdbtransfer.de",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#sdscomSubset",
            "allOf" : [ {
              "$ref" : "#/components/schemas/SdscomSubsetEnumCharacteristic"
            } ]
          },
          "phraseCatalogue" : {
            "description" : "Phrase catalogue: The phrase library(ies) applied in the preparation of the information. The optional attribute PhraseCatalogueId allows multiple catalogues to be used. Phrase must then have an attribute specifying the PhraseCatalogueId.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#phraseCatalogue",
            "allOf" : [ {
              "$ref" : "#/components/schemas/PhraseCatalogueList"
            } ]
          },
          "language" : {
            "description" : "The default language of the information, stated in a format according to ISO 639-1 (2 letters) followed by textual name",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#language",
            "allOf" : [ {
              "$ref" : "#/components/schemas/LanguageCharacteristic"
            } ]
          },
          "regulationsRelatedToCountryOrRegion" : {
            "description" : "Regulatory information related to country or region: What country the information applies to, stated as a code in accordance to ISO 3166 (two letters). This defines which SDSs can be derived from this file. (A SDS may be written in English, and the information given may be in accordance to Norwegian regulations).",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#regulationsRelatedToCountryOrRegion",
            "allOf" : [ {
              "$ref" : "#/components/schemas/RegulationsRelatedToCountryOrRegionList"
            } ]
          },
          "systemUsedInPreparation" : {
            "description" : "Software applied in preparation of information: State which system the information has been exported from. The actual version number of the system applied or any other identifier that helps to understand the export scope or method should also be stated.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#systemUsedInPreparation",
            "allOf" : [ {
              "$ref" : "#/components/schemas/Text"
            } ]
          },
          "dateGeneratedExport" : {
            "description" : "Date of generation of this export file",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#dateGeneratedExport",
            "allOf" : [ {
              "$ref" : "#/components/schemas/DateCharacteristic"
            } ]
          }
        },
        "required" : [ "sdscomVersionNo", "language", "regulationsRelatedToCountryOrRegion", "systemUsedInPreparation", "dateGeneratedExport" ]
      },
