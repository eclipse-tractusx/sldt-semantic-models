            } ]
          },
          "editingDate" : {
            "description" : "If the exporting system is the SDS authoring system, the value of EditingDate should be omitted or be equal to RevisionDate. If the export is prepared by another system, e.g. from a service provider, the EditingDate is the status of data entry of the SDS and is equal to or larger than RevisionDate.",
            "x-samm-aspect-model-urn" : "urn:samm:io.catenax.esdscom:1.0.0#editingDate",
