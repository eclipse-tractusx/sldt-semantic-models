

@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.1.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.1.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.1.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.1.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:io.catenax.shared.attestation_of_conformance:1.0.0#> .
@prefix samm-u: <urn:samm:org.eclipse.esmf.samm:unit:2.1.0#> .

:AttestationOfConformance a samm:Aspect ;
   samm:properties ( :attestationOfConformance ) ;
   samm:operations ( ) ;
   samm:events ( ) .

:attestationOfConformance a samm:Property ;
   samm:preferredName "attestation of conformance"@en ;
   samm:description "Connects Asset with AttestationOfConformance to link it with AttestationOfConformanceCollection, establishing the semantic relationship and context between both entities.\nProperty to collect all attestation of conformance properties."@en ;
   samm:characteristic :AttestationOfConformanceCollection .

:AttestationOfConformanceCollection a samm-c:Collection ;
   samm:preferredName "attestation of conformance collection"@en ;
   samm:description "Collection of Attestation of Conformance properties for a given Asset."@en ;
   samm:dataType :AttestationOfConformanceEntity .

:AttestationOfConformanceEntity a samm:Entity ;
   samm:preferredName "attestation of conformance entity"@en ;
   samm:description "Entity to group all attestation of conformance properties."@en ;
   samm:properties ( :attestationType :standardName :attestationStandard :attestationOfConformanceId [ samm:property :attestationOfConformanceLink; samm:optional true ] :providerName [ samm:property :providerId; samm:optional true ] [ samm:property :completedAt; samm:optional true ] ) .

:attestationType a samm:Property ;
   samm:preferredName "attestation type"@en ;
   samm:description "The specific type of the attestation, which defines its nature and the level of trust or authority it conveys."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "Third-Party Certificate" .

:standardName a samm:Property ;
   samm:preferredName "standard name"@en ;
   samm:description "The specific cross-sectoral standards or product or sector rules (PCRs) on which the attestation of conformance is based."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "ISO/IEC Industry Standard 9001:2015" .

:attestationStandard a samm:Property ;
   samm:preferredName "attestation scheme standard "@en ;
   samm:description "Reference standard or rulebook which serves as the basis for the attestation of conformance."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "Global Assessment Framework v2.0" .

:attestationOfConformanceId a samm:Property ;
   samm:preferredName "attestation of conformance identification"@en ;
   samm:description "A unique identifier assigned to the attestation document for tracking, referencing, and verification purposes."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "4a7c4482-8431-4c31-a895-70341d2a1376" .

:providerName a samm:Property ;
   samm:preferredName "issuer of attestation"@en ;
   samm:description "The official legal name of the organization or body that issued the attestation."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "TÜV-X" .

:attestationOfConformanceLink a samm:Property ;
   samm:preferredName "link to attestation"@en ;
   samm:description "A URL or web link directing to the official digital document or registry entry to verify the authenticity and status of the attestation."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "www.Certifierrepository_example.com/Certificate_123456" .

:providerId a samm:Property ;
   samm:preferredName "issuer of attestation identification"@en ;
   samm:description "A unique identifier for the entity issuing the declaration, such as a Business Partner Number (BPN) or other official registration number, issued by the appointing organization or accreditation institute."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "urn:cofinity-x.com:bpn:BPNL0000000AXXXX" .

:completedAt a samm:Property ;
   samm:preferredName "date of attestation"@en ;
   samm:description "Time stamp for when the attestation of conformity was issued"@en ;
   samm:characteristic samm-c:Timestamp ;
   samm:exampleValue "2022-12-31T23:59:59Z"^^xsd:dateTime .
