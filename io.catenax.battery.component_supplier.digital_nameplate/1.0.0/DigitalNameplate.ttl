@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shared: <urn:samm:io.admin-shell.idta.shared:3.1.0#> .
@prefix : <urn:samm:io.catenax.batterypass.component_supplier.digital_nameplate:1.0.0#> .
@prefix contactInformation: <urn:samm:io.admin-shell.idta.contact_information:1.0.1#> .
@prefix tech: <urn:samm:io.admin-shell.idta.batterypass.technical_data:1.0.3#> 
@prefix batterypassDigitalNameplate: <urn:samm:io.admin-shell.idta.batterypass.digital_nameplate:1.0.1#> .


:DigitalNameplate a samm:Aspect ;
   samm:preferredName "nameplate for battery passport"@en ;
   samm:preferredName "Typenschild für den Batteriepass"@de ;
   samm:description "Contains the nameplate information attached to the product within the Battery Product Passport."@en ;
   samm:description "Enthält die Information zum Typenschild des Produkts im Digitalen Batteriepass."@de ;
   samm:properties ( 
   [ samm:property batterypassDigitalNameplate:uriOfTheProduct; samm:payloadName "URIOfTheProduct" ] 
   [ samm:property batterypassDigitalNameplate:manufacturerName; samm:payloadName "ManufacturerName" ] 
   [ samm:property batterypassDigitalNameplate:addressInformation; samm:optional true; samm:payloadName "AddressInformation" ] 
   [ samm:property batterypassDigitalNameplate:serialNumber; samm:optional true; samm:payloadName "SerialNumber" ] 
   [ samm:property batterypassDigitalNameplate:dateOfManufacture; samm:optional true; samm:payloadName "DateOfManufacture" ] 
   [ samm:property batterypassDigitalNameplate:dateOfPuttingIntoService; samm:optional true; samm:payloadName "DateOfPuttingIntoService" ] 
   [ samm:property batterypassDigitalNameplate:uniqueFacilityIdentifier; samm:optional true; samm:payloadName "UniqueFacilityIdentifier" ]
   [ samm:property batterypassDigitalNameplate:batteryStatus; samm:optional true; samm:payloadName "LifeCycleStage" ]
   [ samm:property batterypassDigitalNameplate:operatorIdentifier; samm:optional true; samm:payloadName "OperatorIdentifier" ] 
   [ samm:property tech:manufacturerIdentifier; samm:payloadName "ManufacturerIdentifier" ] 
   [ samm:property batterypassDigitalNameplate:markings; samm:optional true; samm:payloadName "Markings" ] 
   [ samm:property batterypassDigitalNameplate:euDeclarationOfConformity; samm:optional true; samm:payloadName "EUDeclarationOfConformity" ] 
   [ samm:property batterypassDigitalNameplate:resultsOfTestReportsProvingCompliance; samm:optional true; samm:payloadName "ResultsOfTestReportsProvingCompliance" ] 
   );
   samm:operations ( ) ;
   samm:events ( ) ;
   samm:see <https://admin-shell.io/idta/nameplate/3/0/Nameplate> ;
   samm:see <urn:samm:io.admin-shell.idta.digital_nameplate:3.0.0> .

