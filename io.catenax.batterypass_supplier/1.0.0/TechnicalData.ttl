@prefix : <urn:samm:io.catenax.batterypass_supplier:1.0.0#> .
@prefix batteryPassTechnicalData: <urn:samm:io.admin-shell.idta.batterypass.technical_data:1.0.2#> .


:TechnicalData a samm:Aspect ;
   samm:description "Technical data of the asset and associated product classificatons."@en ;
   samm:see <urn:irdi:0173-1#01-AHX837#002> ;
   samm:properties ( 
   	 [ samm:property batteryPassTechnicalData:generalInformation; samm:payloadName "GeneralInformation" ] 
	 [ samm:property batteryPassTechnicalData:technicalPropertyAreas; samm:payloadName "TechnicalPropertyAreas" ] 
	  ) ;
   samm:operations ( ) ;
   samm:events ( ) .



  